# GrantBot — Environment Variables
# Copy this file to .env and fill in only what you need.
# LOCAL DEV: only GEMINI_API_KEY is required. Everything else has graceful fallbacks.

# ── REQUIRED (for any mode) ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── OPTIONAL (each adds a capability — see config.py for detection logic) ──

# Environment: development | production
# ENV=development

# Twilio (WhatsApp channel)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ChromaDB (vector search — falls back to rule-based seed-JSON matching)
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Firebase / Firestore (persistent sessions — falls back to in-memory)
# FIREBASE_ADMIN_SDK_JSON={"type":"service_account",...}

# BigQuery (XPRIZE evidence logs — falls back to local logs/*.jsonl)
# GCP_PROJECT=your-gcp-project-id

# Razorpay (payments — required for real revenue)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Cloudflare Turnstile (bot protection — skipped if empty)
# CLOUDFLARE_TURNSTILE_SECRET=

# Auth (change in production!)
# JWT_SECRET=dev-only-insecure-secret-change-in-prod
# REFRESH_SECRET=dev-refresh-secret

# Frontend URL (CORS)
# FRONTEND_URL=http://localhost:3000

# Manual payment link (WhatsApp paywall nudge before frontend checkout)
# PAYMENT_LINK_99=
