# ── Sarthi Kalyan — Environment Variables ──
# Copy this to .env and fill in your keys.
# Minimum to run: only GEMINI_API_KEY is required.

# ═══ REQUIRED ═══
GEMINI_API_KEY=your_gemini_api_key_here

# ═══ PAYMENTS (required for revenue) ═══
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# ═══ OPTIONAL — System upgrades gracefully without these ═══

# WhatsApp via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ChromaDB (RAG vector matching — falls back to rule-based)
# CHROMA_HOST=localhost
# CHROMA_PORT=8001

# Firebase / Firestore (persistent sessions — falls back to SQLite)
# FIREBASE_ADMIN_SDK_JSON=

# BigQuery (production evidence logs — falls back to local JSONL)
# GCP_PROJECT=

# Cloudflare Turnstile (bot protection — skipped if empty)
# CLOUDFLARE_TURNSTILE_SECRET=

# Auth
JWT_SECRET=dev-only-insecure-secret-change-in-prod

# URLs
FRONTEND_URL=http://localhost:3000

# Environment: development | production
ENV=development
